<?xml version="1.0" encoding="utf-8"?>
<!-- Greeting changes are scheduled by GlanceWidgetProvider; the date is a TextClock. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/glance_widget_description"
    android:initialLayout="@layout/widget_glance"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_glance"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
