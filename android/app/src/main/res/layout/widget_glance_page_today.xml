<?xml version="1.0" encoding="utf-8"?>
<!-- Page 1: date and weather -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/glance_greeting"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/greeting_morning"
            android:textSize="24sp" />
        <TextClock
            android:id="@+id/glance_date"
            style="@style/WidgetText.Detail"
            android:format12Hour="EEE, d MMM yyyy"
            android:format24Hour="EEE, d MMM yyyy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="16sp" />
        <LinearLayout
            android:id="@+id/glance_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/glance_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/glance_weather_temp"
                style="@style/WidgetText.Detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/glance_dots_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="5dp"
            android:alpha="1"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
    </LinearLayout>
</LinearLayout>
