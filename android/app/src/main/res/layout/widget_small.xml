<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">
    <TextClock
        android:id="@+id/widget_hour"
        android:format12Hour="hh"
        android:format24Hour="HH"
        style="@style/WidgetText.Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="38sp" />
    <TextClock
        android:id="@+id/widget_minute"
        android:format12Hour="mm"
        android:format24Hour="mm"
        style="@style/WidgetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textSize="38sp" />
    <TextView
        style="@style/WidgetText.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="·"
        android:importantForAccessibility="no" />
    <TextClock
        android:id="@+id/widget_date"
        android:format12Hour="EEE d"
        android:format24Hour="EEE d"
        style="@style/WidgetText.Detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
