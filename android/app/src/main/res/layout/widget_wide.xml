<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/widget_time"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
            style="@style/WidgetText.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="52sp" />
        <TextView
            android:id="@+id/widget_alarm"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/widget_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/widget_weather_temp"
            style="@style/WidgetText.Detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp" />
    </LinearLayout>
        <TextClock
            android:id="@+id/widget_date"
        android:format12Hour="MMM, EEEE d"
        android:format24Hour="MMM, EEEE d"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_event"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="170dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
