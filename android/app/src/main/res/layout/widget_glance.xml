<?xml version="1.0" encoding="utf-8"?>
<!-- "At a glance" widget: greeting, then date · weather, then the next event. Frameless. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">
    <TextView
        android:id="@+id/glance_greeting"
        style="@style/WidgetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/greeting_morning"
        android:textSize="24sp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextClock
            android:id="@+id/glance_date"
            style="@style/WidgetText.Detail"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, MMM d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="16sp" />
        <LinearLayout
            android:id="@+id/glance_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/glance_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="5dp" />
            <TextView
                android:id="@+id/glance_weather_temp"
                style="@style/WidgetText.Detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/glance_headphones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/glance_headphones_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_headphones" />
        <TextView
            android:id="@+id/glance_headphones_text"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/glance_event"
        style="@style/WidgetText.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
