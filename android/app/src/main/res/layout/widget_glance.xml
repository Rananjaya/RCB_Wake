<?xml version="1.0" encoding="utf-8"?>
<!-- "My Day" widget: greeting, date, weather, the next event and earphones, one per line. Frameless. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">
    <TextView
        android:id="@+id/glance_greeting"
        style="@style/WidgetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/greeting_morning"
        android:textSize="24sp" />
    <TextClock
        android:id="@+id/glance_date"
        style="@style/WidgetText.Detail"
        android:format12Hour="EEE, MMM d"
        android:format24Hour="EEE, MMM d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textSize="16sp" />
    <LinearLayout
        android:id="@+id/glance_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/glance_weather_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/glance_weather_temp"
            style="@style/WidgetText.Detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/glance_event"
        style="@style/WidgetText.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/glance_headphones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/glance_headphones_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_headphones" />
        <TextView
            android:id="@+id/glance_headphones_text"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
