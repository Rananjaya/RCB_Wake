<?xml version="1.0" encoding="utf-8"?>
<!-- "My Day" widget. Two pages that change automatically every few seconds and on tap
     (launchers keep horizontal swipes for changing home screens, so widgets cannot use them):
     1. optional greeting, date with year, weather;  2. next event, next alarm, earphones.
     Frameless; the page dots show which page is visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <ViewFlipper
        android:id="@+id/glance_pages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoStart="true"
        android:flipInterval="6000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Page 1: date and weather -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/glance_greeting"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/greeting_morning"
                    android:textSize="24sp" />
                <TextClock
                    android:id="@+id/glance_date"
                    style="@style/WidgetText.Detail"
                    android:format12Hour="EEE, d MMM yyyy"
                    android:format24Hour="EEE, d MMM yyyy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textSize="16sp" />
                <LinearLayout
                    android:id="@+id/glance_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/glance_weather_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/glance_weather_temp"
                        style="@style/WidgetText.Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/glance_dots_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="5dp"
                    android:alpha="1"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page 2: what's next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/glance_next_title"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/glance_coming_up"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/glance_event"
                    style="@style/WidgetText.Detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="16sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/glance_alarm"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/glance_headphones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/glance_headphones_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="5dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_headphones" />
                    <TextView
                        android:id="@+id/glance_headphones_text"
                        style="@style/WidgetText.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/glance_dots_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="5dp"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:alpha="1"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot" />
            </LinearLayout>
        </LinearLayout>
    </ViewFlipper>

</LinearLayout>
