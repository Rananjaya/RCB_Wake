<?xml version="1.0" encoding="utf-8"?>
<!-- Page 2: what's next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/glance_next_title"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/glance_coming_up"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/glance_event"
            style="@style/WidgetText.Detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/glance_alarm"
            style="@style/WidgetText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:textSize="14sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/glance_headphones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/glance_headphones_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_headphones" />
            <TextView
                android:id="@+id/glance_headphones_text"
                style="@style/WidgetText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/glance_dots_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="5dp"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:alpha="1"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
    </LinearLayout>
</LinearLayout>
