<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent "glass" panel: a light hairline border over a soft dark tint keeps white text
     readable on bright wallpapers while letting the wallpaper show through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="#38140F26" />
    <stroke android:width="1dp" android:color="#47FFFFFF" />
</shape>
